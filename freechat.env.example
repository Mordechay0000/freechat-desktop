# FreeChat — one configuration file, identical in all three repositories.
#
# Copy to freechat.env and edit. Every key is FREECHAT_*, and a key that means
# the same thing in two repositories has the same name in both, so this one file
# can be shared by freechat-server, freechat-android and freechat-desktop: each
# reads the keys it needs and ignores the rest. Nothing here is secret except
# where a comment says so.
#
# This replaced android/branding/brand.env and desktop/branding/brand.env, which
# held the same information in two dialects. That was not cosmetic. Each one
# carried the server address as its own hand-written string -- a numeric IP in
# one, a hostname in the other -- so the two could disagree, and did. The
# addresses are now DERIVED from FREECHAT_SERVER_IP, FREECHAT_SERVER_DOMAIN and
# FREECHAT_SERVER_PORT below, in the form each platform actually requires, and
# cannot drift apart.

# --- identity --------------------------------------------------------------
# The app name, everywhere it is shown to a user.
FREECHAT_APP_NAME=FreeChat

# Android application id. Must not collide with another app on the device, and
# in particular must differ from the upstream fork's, or the build installs over
# it instead of alongside it. Android only; the other repositories ignore it.
FREECHAT_ANDROID_PACKAGE=com.freechat.messenger

# --- the node --------------------------------------------------------------
# The domain clients reach the node by. Used by every repository:
#   server   advertises it, and it is the name a certificate would be issued for
#   android  FreeChatResolver resolves its A record at app start and caches it
#   desktop  handed to Qt, which resolves it on every connection
FREECHAT_SERVER_DOMAIN=freechat.forum-dev.com

# The node's numeric address. Required, and it must be numeric.
#
# Android's native transport connects with inet_pton
# (TMessagesProj/jni/tgnet/ConnectionSocket.cpp:586), which parses numeric
# addresses only and does not resolve DNS. Given a name it closes the socket
# before calling connect() and returns no error, and the log line for it sits
# behind LOGS_ENABLED -- so a release build is completely silent. The symptom is
# a login that spins forever with no socket ever opened and nothing in the server
# log. That cost a full debugging cycle here.
#
# The domain above is what makes a changed address survivable on Android: this
# value is only the fallback until the first successful lookup. On desktop the
# domain is used directly and this value is not needed at all.
FREECHAT_SERVER_IP=147.234.93.35

# One port for all three. 8080 rather than 443 because Caddy holds 443 on this
# host, and raw MTProto is not HTTP -- multiplexing it behind a reverse proxy
# needs caddy-l4. See docs/09-DEPLOY.md.
FREECHAT_SERVER_PORT=8080

# Wire DC label. The clients and the server must agree; a mismatch looks like a
# successful connection that never completes a handshake.
FREECHAT_SERVER_DC=2

# Shown to the user as the node's name and subtitle. The server also serves both
# over its discovery endpoint.
FREECHAT_SERVER_NAME=FreeChat
FREECHAT_SERVER_DESCRIPTION="Private node"

# The node's RSA PUBLIC key, PKCS#1 PEM ("BEGIN RSA PUBLIC KEY"), relative to
# the platform directory -- android/branding/server-rsa.pub in the Android
# repository, desktop/branding/server-rsa.pub in the desktop one. Each repository
# carries its own copy, because a repository that points outside itself is not
# standalone: the desktop branding previously referenced
# ../android/branding/server-rsa.pub, which exists only when both live under one
# tree, so the published desktop repository had no key at all and could not
# complete a handshake.
#
# Public by design -- every client needs it. NOT the private key, which stays in
# server/upstream/data/server_rsa.pem and never leaves the server.
#
# Get it from a running node:
#   curl -s http://<host>:<port>/freechat/server-info | jq -r .rsa_public_key_pem
#
# Baked into the build, so rotating the server key requires rebuilding the
# clients.
FREECHAT_SERVER_RSA_PUB=branding/server-rsa.pub

# --- public links, the web client, deep links -------------------------------
# Where public links point. A username page, an invite, a sticker-set link, a
# story link: every place a Telegram client builds https://t.me/<something>, this
# build builds <FREECHAT_PUBLIC_URL>/<something> instead, and the server puts the
# same root into the links it generates. Required: there is no sensible default,
# and leaving upstream's would send your users' links to someone else's domain.
#
# This is an ORIGIN, no path. It has to be a different host from the web client
# below, because gramsrv serves /<username> landing pages at the root of this one.
FREECHAT_PUBLIC_URL=https://freechat.forum-dev.com

# Where the web client (freechat-web) is served from. The server allows this
# origin to open WebSocket connections (TELESRV_WEBSOCKET_ALLOWED_ORIGINS), puts it
# into links that open a web client, and the web build connects back to this
# host. Also an origin, no path.
FREECHAT_WEB_URL=https://web.freechat.forum-dev.com

# The deep-link scheme the apps register: freechat://resolve?domain=...
# Lower-case letters, digits, + . - only.
FREECHAT_URL_SCHEME=freechat

# Web client only, and only for development: where the page's WebSocket goes when
# that is not the host it was served from. In production leave all three unset --
# the page talks to its own host, and Caddy forwards /apiws to gramsrv.
# FREECHAT_WEB_DC_HOST=localhost
# FREECHAT_WEB_DC_PORT=8080
# FREECHAT_WEB_WS_PATH=/apiws

# --- client behaviour ------------------------------------------------------
# Keep Telegram's own cloud selectable in the client. false for a private
# network. Every removal is recorded in docs/05-REMOVED-FEATURES.md.
FREECHAT_INCLUDE_TELEGRAM=false

# Web client only: which network ONE web build talks to. A browser origin keeps a
# single set of auth keys, so a build is one network, never a runtime switch --
# switching on one origin would hand a key made on one network to the other.
#   freechat   (default) your node; the stock network code is deleted from the build
#   telegram   Telegram's own cloud. Needs FREECHAT_INCLUDE_TELEGRAM=true AND
#              FREECHAT_API_ID / FREECHAT_API_HASH of your OWN from my.telegram.org
#              (the ones below only work against a gramsrv node). Serve that build
#              from a different origin than the freechat one.
# FREECHAT_WEB_NETWORK=freechat

# Skip the server picker entirely and go straight to the phone number entry, the
# way Telegram does. Requires a compiled-in address and RSA key.
#
# false is not just a cosmetic change back: with another node selectable, the
# client held a live MTProto session on someone else's server while reporting
# itself connected, and never showed a login screen, because the configured
# server had no auth key for it. That is the failure this setting removes.
FREECHAT_AUTO_JOIN=true

# Telegram application credentials. Both clients' build systems require them.
#
# gramsrv does not validate either: internal/rpc/auth.go:874 has no application
# registry and only records the values. So any pair works for a self-hosted node
# and my.telegram.org is not involved. Change them only to also connect a build
# to Telegram's own network, which needs credentials of your own.
FREECHAT_API_ID=3893395
FREECHAT_API_HASH=e2adbe11ee0f092ced6043c4e051fdda

# --- macOS -------------------------------------------------------------------
# Oldest macOS the desktop client runs on. Applied in BOTH places upstream sets
# it -- Telegram/build/prepare/prepare.py, which builds Qt, FFmpeg and the other
# libraries, and CMAKE_OSX_DEPLOYMENT_TARGET for the app -- because a mismatch
# between the two is a link error. Upstream says 10.13; current Xcode refuses to
# target anything that old, so this is 12.0. Desktop repository only.
#
# Resolved against the installed Xcode, not taken on trust: if its SDK no longer
# supports this version the value is raised to the SDK's floor (dropping support
# for older macOS, and the scripts say so), and if it is newer than the SDK can
# target, it is lowered. The supported range moves between Xcode releases -- it
# went from "12.0 and up" to "10.13 to 26.5.99" in this project in one day -- so
# the scripts read it from the SDK's SDKSettings.plist rather than assuming it.
# ./scripts/build-desktop.sh doctor prints the range and what would be used.
FREECHAT_MACOS_DEPLOYMENT_TARGET=12.0
